# Toby server configuration — copy to .env and adjust; the real .env is never committed.
# All values are optional; defaults shown.
# Full explanations: docs/operations/local-dev.md (中文完整说明: local-dev.zh.md)

# ── Server ──────────────────────────────────────

TOBY_HOST=127.0.0.1
TOBY_PORT=8629

# ── Database ────────────────────────────────────
# sqlite | mysql (mysql reads the block below)

TOBY_DB_DIALECT=sqlite

# MySQL connection
# TOBY_DB_MYSQL_HOST=127.0.0.1
# TOBY_DB_MYSQL_PORT=3306
# TOBY_DB_MYSQL_USER=toby
# TOBY_DB_MYSQL_PASSWORD=
# TOBY_DB_MYSQL_DATABASE_PREFIX=toby_

# ── AI runtime (pi-ai) ──────────────────────────
# pi-ai "provider/model" pair; unset = AI off

# TOBY_AI_MODEL=deepseek/deepseek-flash

# Provider credential (per-provider env var)
# DEEPSEEK_API_KEY=

# ms (1000–120000)
# TOBY_AI_TIMEOUT_MS=30000

# ── Auth ────────────────────────────────────────
# set = login on
# generate: node scripts/hash-password.js "your password"

# TOBY_AUTH_PASSWORD_HASH=
# hours (1–8760)
# TOBY_AUTH_SESSION_TTL_HOURS=168
# true = append Secure (HTTPS)
# TOBY_AUTH_SECURE_COOKIE=false

# ── Reverse proxy ───────────────────────────────
# ── Runtime ─────────────────────────────────────

# TOBY_DATA_ROOT=./data
