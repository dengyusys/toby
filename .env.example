# Toby server configuration — copy to .env and adjust; the real .env is never committed.
# Toby 服务端配置 —— 复制为 .env 后按需修改;真实 .env 永不提交。
# All values are optional; defaults shown. / 所有值均可省略,以下为默认值。

TOBY_HOST=127.0.0.1
TOBY_PORT=8629

# Database dialect for every domain database: sqlite (default — one file
# data/<domain>.db under TOBY_DATA_ROOT) or mysql (one schema <prefix><domain>
# per domain, created at startup).
# 数据库方言,作用于所有域数据库:sqlite(默认 —— 每域一个文件
# data/<域>.db,落在 TOBY_DATA_ROOT)或 mysql(每域一个 schema
# <前缀><域>,启动时创建)。
TOBY_DB_DIALECT=sqlite

# MySQL connection — read only when TOBY_DB_DIALECT=mysql.
# MySQL 连接 —— 仅在 TOBY_DB_DIALECT=mysql 时读取。
# TOBY_DB_MYSQL_HOST=127.0.0.1
# TOBY_DB_MYSQL_PORT=3306
# TOBY_DB_MYSQL_USER=toby
# TOBY_DB_MYSQL_PASSWORD=
# TOBY_DB_MYSQL_DATABASE_PREFIX=toby_

# TOBY_DATA_ROOT=./data
# TOBY_LOG_LEVEL=info
