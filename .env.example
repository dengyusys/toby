# Toby server configuration — copy to .env and adjust; the real .env is never committed.
# Toby 服务端配置 —— 复制为 .env 后按需修改;真实 .env 永不提交。
# All values are optional; defaults shown. / 所有值均可省略,以下为默认值。

TOBY_HOST=127.0.0.1
TOBY_PORT=8629

# Database dialect for every domain database: sqlite (default — one file
# data/<domain>.db under TOBY_DATA_ROOT) or mysql (one schema <prefix><domain>
# per domain, created at startup).
# 数据库方言,作用于所有域数据库:sqlite(默认 —— 每域一个文件
# data/<域>.db,落在 TOBY_DATA_ROOT)或 mysql(每域一个 schema
# <前缀><域>,启动时创建)。
TOBY_DB_DIALECT=sqlite

# MySQL connection — read only when TOBY_DB_DIALECT=mysql.
# MySQL 连接 —— 仅在 TOBY_DB_DIALECT=mysql 时读取。
# TOBY_DB_MYSQL_HOST=127.0.0.1
# TOBY_DB_MYSQL_PORT=3306
# TOBY_DB_MYSQL_USER=toby
# TOBY_DB_MYSQL_PASSWORD=
# TOBY_DB_MYSQL_DATABASE_PREFIX=toby_

# AI runtime via the pi-ai unified API. TOBY_AI_MODEL is a
# "provider/model" pair from the pi-ai catalog (e.g. "zai/glm-4.7" for
# Z.ai GLM, "openai/gpt-5o", "deepseek/deepseek-chat"). Leave it unset to
# keep the AI paths unavailable — the structured entry path works without
# it. Provider credentials live in each provider's own environment
# variable (e.g. ZAI_API_KEY for zai) or pi-ai's credential store — never
# in this file's variables.
# AI 运行时,经 pi-ai 统一 API 接入。TOBY_AI_MODEL 是 pi-ai 目录中的
# "provider/model" 组合(如 Z.ai GLM 用 "zai/glm-4.7"、"openai/gpt-5o"、
# "deepseek/deepseek-chat")。留空则 AI 路径不可用 —— 结构化录入路径
# 不受影响。各供应商的密钥放在它自己的环境变量里(如 zai 用
# ZAI_API_KEY)或 pi-ai 凭据库 —— 不使用本文件的变量。
# TOBY_AI_MODEL=zai/glm-4.7
# ZAI_API_KEY=
# TOBY_AI_TIMEOUT_MS=30000

# Single-user authentication: set a password hash to enable login for
# public deployments; leave unset for the local, login-free behavior.
# Generate the hash with: node scripts/hash-password.js "your password"
# 单用户认证:配置密码哈希即为公网部署启用登录;留空保持本地免登录行为。
# 哈希生成:node scripts/hash-password.js "你的密码"
# TOBY_AUTH_PASSWORD_HASH=
# TOBY_AUTH_SESSION_TTL_HOURS=168
# TOBY_AUTH_RATE_LIMIT_MAX=5
# TOBY_AUTH_RATE_LIMIT_WINDOW_MS=60000
# Append "; Secure" to the session cookie when serving over HTTPS.
# 经 HTTPS 提供服务时开启(会话 Cookie 追加 Secure)。
# TOBY_AUTH_SECURE_COOKIE=false

# Trust X-Forwarded-For from a reverse proxy in front of the server, so the
# login rate limiter sees real client addresses. Enable ONLY behind a proxy
# you control — a directly exposed server would let clients spoof the header.
# 信任前置反向代理的 X-Forwarded-For,使登录限流按真实客户端地址分桶。
# 只在受自己掌控的代理后开启 —— 直连暴露时客户端可伪造该头绕过限流。
# TOBY_TRUST_PROXY=false

# TOBY_DATA_ROOT=./data
# TOBY_LOG_LEVEL=info
