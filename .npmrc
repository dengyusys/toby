# China mirror for faster installs; remove this line if it slows CI or collaborators abroad.
# 国内镜像,加速安装;拖慢 CI 或影响海外协作时删除此行。
registry=https://registry.npmmirror.com/

# Enforce the Node/pnpm versions pinned in package.json "engines" — wrong version fails install.
# 强制执行 package.json "engines" 固定的 Node/pnpm 版本 —— 版本不符则安装失败。
engine-strict=true
