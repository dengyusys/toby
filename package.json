{
  "name": "toby",
  "description": "Self-hosted personal assistant: one sentence becomes a constrained AI proposal; the server writes only after the user confirms.",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": "22.23.2"
  },
  "scripts": {
    "dev": "node scripts/dev.js",
    "start": "pnpm run build && node --env-file-if-exists=.env apps/server/dist/main.js",
    "build": "pnpm --filter @toby/web build && pnpm --filter @toby/web-mobile build && pnpm --filter @toby/server build",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "pnpm -r --if-present run test && pnpm --filter @toby/server run build && vitest run",
    "backup": "pnpm --filter @toby/server run backup",
    "prepare": "simple-git-hooks"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged",
    "commit-msg": "pnpm exec commitlint --edit $1"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.0.0",
    "@commitlint/config-conventional": "^19.0.0",
    "@eslint/js": "^9.0.0",
    "@types/node": "catalog:",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.0",
    "globals": "^16.0.0",
    "lint-staged": "^15.0.0",
    "prettier": "^3.0.0",
    "simple-git-hooks": "^2.0.0",
    "typescript": "catalog:",
    "typescript-eslint": "^8.0.0",
    "vitest": "catalog:"
  }
}
