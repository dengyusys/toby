{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    // Nest 必需：emitDecoratorMetadata 支撑构造器注入与 Nest 自身装饰器。
    // vitest 经 unplugin-swc（见 vitest.config.ts）产出同样的装饰器元数据，
    // 测试与 nest build 行为一致。
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    // server 允许非可擦除语法（装饰器/类参数属性）；web 与 packages 维持原有规则
    "erasableSyntaxOnly": false
  },
  "include": ["src", "test", "vitest.config.ts"]
}
