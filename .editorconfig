# EditorConfig — keep editors consistent with Prettier and .gitattributes
# EditorConfig —— 使编辑器与 Prettier、.gitattributes 保持一致
# https://editorconfig.org

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown — do not trim them
# 行尾两个空格是 Markdown 的硬换行 —— 不要裁剪
trim_trailing_whitespace = false
