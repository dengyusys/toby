# Toby server environment template — copy to .env on the server and fill in.
# Never commit a real .env (gitignored). 密码与密钥永不入库。
# Copy as: cp env.example .env   (in the same folder as compose.server.yaml)

# Required: login password hash. Generate on your dev machine, repo root:
#   node scripts/hash-password.js 'your-login-password'
# Paste the whole scrypt$... output here.
# 必填:登录密码哈希。在本机仓库根目录执行上面的命令生成,
# 把输出的 scrypt$... 整串粘到这里。
TOBY_AUTH_PASSWORD_HASH=

# As needed: AI provider keys — fill in the ones you actually use.
# 按需:AI 服务商密钥,填你实际在用的。
DEEPSEEK_API_KEY=

# Do NOT set TOBY_DATA_ROOT on a server: inside the container the data root is
# always /app/data, mapped to ./data by compose.server.yaml.
# 不要设置 TOBY_DATA_ROOT:容器内数据根固定为 /app/data,
# 由 compose.server.yaml 的 ./data:/app/data 卷接管。
